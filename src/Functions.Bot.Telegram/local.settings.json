{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=True",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "KeyVaultName": "kv-presettie-dev",

    "APPINSIGHTS_INSTRUMENTATIONKEY": "<Application Insights Instrumentation Key>",

    "Telegram__Token": "<Telegram bot token>",
    "Telegram__BotUrl": "<Telegram bot url, e.g. https://t.me/*bot_name*>",

    "Database__ConnectionString": "<MongoDB connection string>",
    "Database__Name": "presettie",

    "Resources__DefaultLang": "en",

    "Auth__ClientId": "<Spotify Client ID>",
    "Auth__ClientSecret": "<Spotify Client Secret>",
    "Auth__CallbackUrl": "http://localhost:7071/api/spotify/callback",
    "Auth__Scopes__0": "playlist-modify-private",
    "Auth__Scopes__1": "playlist-modify-public",
    "Auth__Scopes__2": "user-library-read",

    "API__Url": "<API URL>",
    "API__Key": "<API Key>",

    "Storage__ConnectionString": "<Azure storage account connection string>",
    "Storage__QueueName": "bot-requests"
  }
}