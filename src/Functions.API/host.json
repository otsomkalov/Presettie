{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    },
    "logLevel": {
      "Host.Startup": "Warning",
      "Microsoft.Azure.WebJobs": "Warning",
      "Host": "Warning"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    }
  }
}