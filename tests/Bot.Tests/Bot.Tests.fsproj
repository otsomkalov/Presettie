<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>20</NoWarn>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Mocks.fs" />
    <Compile Include="IncludedPlaylist.fs" />
    <Compile Include="ExcludedPlaylist.fs" />
    <Compile Include="TargetedPlaylist.fs" />
    <Compile Include="User.fs" />
    <Compile Include="PresetSettings.fs" />
    <Compile Include="Click.fs" />
    <Compile Include="Message.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72"/>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0"/>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0"/>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain.Tests\Domain.Tests.fsproj" />
    <ProjectReference Include="..\..\src\Bot\Bot.fsproj" />
  </ItemGroup>

</Project>
